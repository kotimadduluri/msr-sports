# Copy to .env for local development. In production set these in the host's
# environment (Render dashboard / docker -e); never commit real values.

PORT=4000

# REQUIRED in production — any long random string. Anyone who knows it can forge logins.
JWT_SECRET=change-this-to-a-long-random-string

# Where msr.db and its nightly backups live. Point at the persistent disk.
# DATA_DIR=/data

# First-boot admin login (only used when the users table is empty).
# If unset, phone defaults to 9000000001 and a one-time password is printed
# in the server log on first start — change it in Settings after signing in.
# ADMIN_PHONE=
# ADMIN_PASSWORD=

# Set to 1 to skip the nightly on-disk backup schedule (e.g. in tests).
# DISABLE_BACKUPS=1
